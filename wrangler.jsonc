{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horserun",
  "main": "party/server.ts",
  "compatibility_date": "2024-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "Main"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Main"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
