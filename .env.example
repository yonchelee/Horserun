# Real-time multiplayer (Cloudflare Workers + partyserver). Leave both
# unset to fall back to the in-browser mock (single human + 4 bots, no
# networking).
#
# For local dev:   VITE_PARTYKIT_HOST=127.0.0.1:8787
# For production:  VITE_PARTYKIT_HOST=horserun.<your-handle>.workers.dev
VITE_PARTYKIT_HOST=
VITE_PARTYKIT_ROOM=main

# Kakao Login JavaScript key. Leave unset to hide the Kakao button and
# fall back to a guest name input.
# Get one at https://developers.kakao.com → My Application → JavaScript Key
VITE_KAKAO_JS_KEY=
